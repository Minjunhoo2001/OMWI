#!/bin/bash
#BSUB -J OMHI_test
#BSUB -q blade
#BSUB -n 40
#BSUB -R "span[hosts=1]"
#BSUB -o logs/OMHI_test.out
#BSUB -e logs/OMHI_test.err

set -uo pipefail

echo "[OMHI] Job started at: $(date)"
echo "[OMHI] Job ID: ${LSB_JOBID:-NA}"
echo "[OMHI] Host: $(hostname)"

# =========================================================
# 1. Project directory
# =========================================================
PROJECT_DIR="/share/home/HeMinjun/metagenomic/GitHub"
cd "${PROJECT_DIR}"

# =========================================================
# 2. Activate conda environment
# =========================================================
source /share/home/HeMinjun/miniconda3/etc/profile.d/conda.sh
conda activate omhi_env

echo "[OMHI] Conda env: ${CONDA_DEFAULT_ENV}"
which fastp
which bowtie2
which metaphlan
which merge_metaphlan_tables.py
which Rscript
which python

# =========================================================
# 3. Pipeline parameters
# =========================================================
export THREADS=4
export HOST_INDEX="/share/home/LiaoYing/db/bowtie2/human_ref"
export MPA_DB="/share/home/HeMinjun/db/metaphlan4"
export MPA_INDEX="mpa_vJun23_CHOCOPhlAnSGB_202403"

SAMPLE_SHEET="samples.test.tsv"
OUTDIR="test_results_env"

# =========================================================
# 4. Run OMHI pipeline
# =========================================================
bash workflow/run_omhi_pipeline.sh "${SAMPLE_SHEET}" "${OUTDIR}"

echo "[OMHI] Job finished at: $(date)"
echo "[OMHI] Final result:"
ls -lh "${OUTDIR}/05.omhi/omhi_scores.tsv"
head "${OUTDIR}/05.omhi/omhi_scores.tsv"
